#!/usr/bin/env bash
# Native messaging host entry point for Granola on Linux. Chrome spawns this
# file directly; it runs the JS bridge with the Electron runtime we ship, in
# plain node mode (ELECTRON_RUN_AS_NODE), so no system Node is required.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME=""
for up in ../../ ../../../; do
  for name in granola electron; do
    cand="$DIR/$up$name"
    if [[ -x "$cand" ]]; then RUNTIME="$cand"; break 2; fi
  done
done
[[ -n "$RUNTIME" ]] || { echo "Granola runtime not found" >&2; exit 1; }
exec env ELECTRON_RUN_AS_NODE=1 "$RUNTIME" "$DIR/meet-consent-bridge.js" "$@"
